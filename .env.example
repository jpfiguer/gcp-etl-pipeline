# copiar a .env y completar
# gcp
GCP_PROJECT=my-project
GCP_REGION=us-central1

# pub/sub
PUBSUB_TOPIC=cdc-events
PUBSUB_SUBSCRIPTION=cdc-events-pipeline

# bigquery
BQ_DATASET_RAW=raw
BQ_DATASET_BRONZE=bronze
BQ_DATASET_SILVER=silver
BQ_DATASET_GOLD=gold
BQ_TABLE_EVENTS=events

# pipeline
DEDUP_WINDOW_SECONDS=600
RUNNER=DirectRunner
STREAMING=true
LOG_LEVEL=INFO
LOG_FORMAT=console

# dataflow (solo si RUNNER=DataflowRunner)
DATAFLOW_STAGING=gs://your-bucket/staging
DATAFLOW_TEMP=gs://your-bucket/temp
DATAFLOW_SERVICE_ACCOUNT=dataflow-worker@my-project.iam.gserviceaccount.com

# cloud function validation
DEVIATION_PCT_ROWS=0.30
DEVIATION_PCT_TABLE=0.40
MAX_FRESHNESS_MINUTES=30
ALERT_TOPIC=cdc-validation-alerts
